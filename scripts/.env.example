# Configuracion de ./sync.sh
# cp scripts/.env.example scripts/.env

# ---------------------------------------------------------------
# Kiwi TCMS
# ---------------------------------------------------------------
KIWI_ENABLED=true
# Si se omiten, kiwi2md.py usa scripts/env/.tcms.conf
TCMS_URL=https://localhost/xml-rpc/
TCMS_USERNAME=admin
TCMS_PASSWORD=admin

# ---------------------------------------------------------------
# GitLab (valores globales, cada grupo puede sobreescribirlos)
# ---------------------------------------------------------------
GITLAB_BASE_URL=https://gitlab.com
GITLAB_API_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx
GITLAB_ISSUE_STATE=all
# GITLAB_OUTPUT_DIR=../rag/gitlab

# Grupos de tickets a descargar, separados por coma.
# Cada grupo <NOMBRE> se configura con variables GITLAB_<NOMBRE>_*
#   PROJECT_ID  (requerido) path o id del proyecto
#   STATE       opened | closed | all (default: GITLAB_ISSUE_STATE)
#   ISSUES      IIDs puntuales separados por coma (si se define, ignora STATE)
#   OUTPUT_DIR  directorio de salida (default: rag/gitlab)
#   BASE_URL    URL de GitLab para este grupo
#   TOKEN       token para este grupo
#   ENABLED     true/false (default: true)
GITLAB_GROUPS=core,docs,urgentes

GITLAB_CORE_PROJECT_ID=grupo/proyecto
GITLAB_CORE_STATE=opened

GITLAB_DOCS_PROJECT_ID=grupo/docs
GITLAB_DOCS_STATE=all
GITLAB_DOCS_OUTPUT_DIR=../rag/gitlab/docs

GITLAB_URGENTES_PROJECT_ID=grupo/proyecto
GITLAB_URGENTES_ISSUES=123,456,789

# ---------------------------------------------------------------
# Conteo de tokens (opcional, corre al final de ./sync.sh)
# ---------------------------------------------------------------
TOKENS_ENABLED=false
# TOKENS_MODELS=text-embedding-3-small,gemini-embedding-001
# TOKENS_CSV=tokens/tokens_report.csv
