LOG_LEVEL=INFO

RAG_ROOT_PATH=rag
TRACEABILITY_DB_PATH=data/traceability.db

VECTOR_STORE_PROVIDER=qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_NAME=rag_docs
QDRANT_PREFER_GRPC=false
# QDRANT_API_KEY=your_qdrant_api_key

# VECTOR_STORE_PROVIDER=turbovec
# VECTOR_STATE_DIR=vector_state
# TURBOVEC_STORE_DIR=turbovec_index
# TURBOVEC_BIT_WIDTH=4

CHUNK_SIZE=1200
CHUNK_OVERLAP=150
RETRIEVAL_K=5
HASH_ALGORITHM=xxhash
FORCE_REINDEX=false

# EMBEDDINGS_PROVIDER=huggingface
# EMBEDDINGS_MODEL_HF=sentence-transformers/all-MiniLM-L6-v2
EMBEDDINGS_PROVIDER=ollama
EMBEDDINGS_MODEL_OLLAMA=nomic-embed-text
# EMBEDDINGS_MODEL_OPENAI=text-embedding-3-small
# EMBEDDINGS_MODEL_GEMINI=gemini-embedding-2-preview

LLM_TEMPERATURE=0.1

LLM_PROVIDER=ollama
LLM_MODEL_OLLAMA=phi3:3.8b
LLM_OLLAMA_BASE_URL=http://localhost:11434

# LLM_PROVIDER=gemini
# LLM_MODEL_GEMINI=gemini-1.5-flash
